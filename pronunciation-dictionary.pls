<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0"
    xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
        http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
    alphabet="ipa" xml:lang="ko">

  <!-- 
    ======================================================================
    ElevenLabs Pronunciation Dictionary (PLS 1.0)
    ======================================================================
    Use this file to customize how ElevenLabs announces player names.
    Note: PLS is case-sensitive! Include both Hangul and English casing.

    HOW TO ADD OR MODIFY NAMES:
    1. Using IPA (International Phonetic Alphabet):
       <lexeme>
         <grapheme>민준</grapheme>
         <phoneme>/min.dʑun/</phoneme>
       </lexeme>
       <lexeme>
         <grapheme>Minjun</grapheme>
         <phoneme>/min.dʑun/</phoneme>
       </lexeme>

    2. Using an Alias (phonetic English spelling):
       <lexeme>
         <grapheme>혜진</grapheme>
         <alias>Hye-jin</alias>
       </lexeme>
       <lexeme>
         <grapheme>Hyejin</grapheme>
         <alias>Hye-jean</alias>
       </lexeme>
    ======================================================================
  -->

